+// Pangolin: queues a redraw of [region] (frame pixels), rounding outwards.
+static void queue_draw_frame_region(GtkWidget* widget,
+                                    const cairo_region_t* region,
+                                    gint scale_factor) {
+  cairo_region_t* logical = cairo_region_create();
+  for (int i = 0; i < cairo_region_num_rectangles(region); i++) {
+    cairo_rectangle_int_t r;
+    cairo_region_get_rectangle(region, i, &r);
+    cairo_rectangle_int_t l = {r.x / scale_factor, r.y / scale_factor, 0, 0};
+    l.width = (r.x + r.width + scale_factor - 1) / scale_factor - l.x;
+    l.height = (r.y + r.height + scale_factor - 1) / scale_factor - l.y;
+    cairo_region_union_rectangle(logical, &l);
+  }
+  gtk_widget_queue_draw_region(widget, logical);
+  cairo_region_destroy(logical);
+}
+
+// Pangolin: what [cr] paints (GTK's clip: the region queued and what older
+// buffers miss), in frame pixels: only pixels wholly inside. Null when the
+// clip isn't made of rectangles.
+static cairo_region_t* painted_region(cairo_t* cr, gint scale_factor) {
+  cairo_rectangle_list_t* rects = cairo_copy_clip_rectangle_list(cr);
+  if (rects->status != CAIRO_STATUS_SUCCESS) {
+    cairo_rectangle_list_destroy(rects);
+    return nullptr;
+  }
+  cairo_region_t* painted = cairo_region_create();
+  for (int i = 0; i < rects->num_rectangles; i++) {
+    const cairo_rectangle_t& r = rects->rectangles[i];
+    int left = static_cast<int>(std::ceil(r.x * scale_factor));
+    int top = static_cast<int>(std::ceil(r.y * scale_factor));
+    int right = static_cast<int>(std::floor((r.x + r.width) * scale_factor));
+    int bottom = static_cast<int>(std::floor((r.y + r.height) * scale_factor));
+    if (right > left && bottom > top) {
+      cairo_rectangle_int_t rect = {left, top, right - left, bottom - top};
+      cairo_region_union_rectangle(painted, &rect);
+    }
+  }
+  cairo_rectangle_list_destroy(rects);
+  return painted;
+}
