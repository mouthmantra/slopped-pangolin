diff --git a/engine/src/flutter/shell/platform/linux/fl_pangolin_damage.cc b/engine/src/flutter/shell/platform/linux/fl_pangolin_damage.cc
new file mode 100644
index 00000000..67badab4
--- /dev/null
+++ b/engine/src/flutter/shell/platform/linux/fl_pangolin_damage.cc
@@ -0,0 +1,189 @@
+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Pangolin: real damage for Flutter's surfaces on Wayland.
+//
+// GTK 3 binds wl_compositor at version 3, so Mesa can't use
+// wl_surface.damage_buffer and damages the whole surface on every
+// eglSwapBuffers (wl_surface.damage(0, 0, INT32_MAX, INT32_MAX)). A
+// full-screen, mostly transparent surface (Pangolin's shell) then makes the
+// compositor composite the whole screen for every frame, a clock tick
+// included. This library is loaded before libwayland-client, so its
+// wl_proxy_marshal_flags is the one Mesa and GTK call: it forwards
+// everything, except that whole-surface damage of a surface that has a
+// region registered (fl_pangolin_damage_set), which becomes that region.
+
+#include "flutter/shell/platform/linux/fl_pangolin_damage.h"
+
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include <dlfcn.h>
+#include <gdk/gdkwayland.h>
+#include <wayland-client-core.h>
+
+#include <climits>
+#include <cstdarg>
+#include <cstring>
+
+namespace {
+
+constexpr uint32_t kWlSurfaceDamage = 2;  // destroy, attach, damage
+constexpr int kMaxArguments = 20;  // WL_CLOSURE_MAX_ARGS
+
+using MarshalArrayFlags = struct wl_proxy* (*)(struct wl_proxy*,
+                                                uint32_t,
+                                                const struct wl_interface*,
+                                                uint32_t,
+                                                uint32_t,
+                                                union wl_argument*);
+using GetId = uint32_t (*)(struct wl_proxy*);
+
+GMutex mutex;
+// Surface id -> cairo_region_t* (surface coordinates).
+GHashTable* regions = nullptr;
+
+MarshalArrayFlags real_marshal() {
+  static MarshalArrayFlags real = reinterpret_cast<MarshalArrayFlags>(
+      dlsym(RTLD_NEXT, "wl_proxy_marshal_array_flags"));
+  return real;
+}
+
+uint32_t proxy_id(struct wl_proxy* proxy) {
+  static GetId get_id =
+      reinterpret_cast<GetId>(dlsym(RTLD_DEFAULT, "wl_proxy_get_id"));
+  return get_id != nullptr ? get_id(proxy) : 0;
+}
+
+// libwayland's proxies start with their wl_object, which starts with the
+// interface (wl_proxy_get_interface is too recent to rely on).
+const struct wl_interface* proxy_interface(struct wl_proxy* proxy) {
+  return *reinterpret_cast<const struct wl_interface* const*>(proxy);
+}
+
+// The region registered for the surface, if this is its whole-surface
+// damage; null otherwise.
+cairo_region_t* take_region(struct wl_proxy* proxy,
+                            uint32_t opcode,
+                            const union wl_argument* args) {
+  if (opcode != kWlSurfaceDamage || regions == nullptr) {
+    return nullptr;
+  }
+  const struct wl_interface* interface = proxy_interface(proxy);
+  if (interface == nullptr || strcmp(interface->name, "wl_surface") != 0) {
+    return nullptr;
+  }
+  if (args[0].i != 0 || args[1].i != 0 || args[2].i != INT32_MAX ||
+      args[3].i != INT32_MAX) {
+    return nullptr;
+  }
+  g_mutex_lock(&mutex);
+  gpointer key = GUINT_TO_POINTER(proxy_id(proxy));
+  cairo_region_t* region =
+      static_cast<cairo_region_t*>(g_hash_table_lookup(regions, key));
+  if (region != nullptr) {
+    g_hash_table_steal(regions, key);
+  }
+  g_mutex_unlock(&mutex);
+  return region;
+}
+
+}  // namespace
+
+void fl_pangolin_damage_set(GdkWindow* window, cairo_region_t* region) {
+  if (!GDK_IS_WAYLAND_WINDOW(window)) {
+    g_clear_pointer(&region, cairo_region_destroy);
+    return;
+  }
+  struct wl_surface* surface = gdk_wayland_window_get_wl_surface(window);
+  if (surface == nullptr) {
+    g_clear_pointer(&region, cairo_region_destroy);
+    return;
+  }
+  gpointer key =
+      GUINT_TO_POINTER(proxy_id(reinterpret_cast<struct wl_proxy*>(surface)));
+  g_mutex_lock(&mutex);
+  if (regions == nullptr) {
+    regions = g_hash_table_new_full(g_direct_hash, g_direct_equal, nullptr,
+                                    reinterpret_cast<GDestroyNotify>(
+                                        cairo_region_destroy));
+  }
+  if (region != nullptr) {
+    g_hash_table_replace(regions, key, region);
+  } else {
+    g_hash_table_remove(regions, key);
+  }
+  g_mutex_unlock(&mutex);
+}
+
+extern "C" __attribute__((visibility("default"))) struct wl_proxy*
+wl_proxy_marshal_flags(struct wl_proxy* proxy,
+                       uint32_t opcode,
+                       const struct wl_interface* interface,
+                       uint32_t version,
+                       uint32_t flags,
+                       ...) {
+  MarshalArrayFlags real = real_marshal();
+  if (real == nullptr) {
+    g_error("wl_proxy_marshal_array_flags is missing (libwayland < 1.20)");
+  }
+
+  // The arguments, as libwayland reads them (wl_argument_from_va_list).
+  union wl_argument args[kMaxArguments] = {};
+  const struct wl_message* message = &proxy_interface(proxy)->methods[opcode];
+  va_list ap;
+  va_start(ap, flags);
+  int count = 0;
+  for (const char* s = message->signature; *s != '\0' && count < kMaxArguments;
+       s++) {
+    switch (*s) {
+      case 'i':
+        args[count++].i = va_arg(ap, int32_t);
+        break;
+      case 'u':
+        args[count++].u = va_arg(ap, uint32_t);
+        break;
+      case 'f':
+        args[count++].f = va_arg(ap, wl_fixed_t);
+        break;
+      case 's':
+        args[count++].s = va_arg(ap, const char*);
+        break;
+      case 'o':
+        args[count++].o = va_arg(ap, struct wl_object*);
+        break;
+      case 'n':
+        args[count++].o = va_arg(ap, struct wl_object*);
+        break;
+      case 'a':
+        args[count++].a = va_arg(ap, struct wl_array*);
+        break;
+      case 'h':
+        args[count++].h = va_arg(ap, int32_t);
+        break;
+      default:
+        // '?' (nullable) and digits (since version) qualify the next type.
+        break;
+    }
+  }
+  va_end(ap);
+
+  cairo_region_t* region = take_region(proxy, opcode, args);
+  if (region == nullptr) {
+    return real(proxy, opcode, interface, version, flags, args);
+  }
+  int rects = cairo_region_num_rectangles(region);
+  for (int i = 0; i < rects; i++) {
+    cairo_rectangle_int_t rect;
+    cairo_region_get_rectangle(region, i, &rect);
+    union wl_argument damage[4];
+    damage[0].i = rect.x;
+    damage[1].i = rect.y;
+    damage[2].i = rect.width;
+    damage[3].i = rect.height;
+    real(proxy, opcode, interface, version, flags, damage);
+  }
+  cairo_region_destroy(region);
+  return nullptr;
+}
