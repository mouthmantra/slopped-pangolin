+#ifndef FLUTTER_SHELL_PLATFORM_LINUX_FL_PANGOLIN_DAMAGE_H_
+#define FLUTTER_SHELL_PLATFORM_LINUX_FL_PANGOLIN_DAMAGE_H_
+
+#include <gtk/gtk.h>
+
+G_BEGIN_DECLS
+
+/**
+ * fl_pangolin_damage_set:
+ * @window: a toplevel #GdkWindow.
+ * @region: (transfer full) (nullable): what changed in the next frame of the
+ * window's surface, in surface coordinates, or %NULL for everything.
+ *
+ * Pangolin: GTK 3 binds wl_compositor at version 3, so Mesa can't send
+ * damage_buffer and reports the whole surface as changed on every swap. The
+ * region given here replaces that whole-surface damage at the next swap of
+ * the window's surface (see wl_proxy_marshal_flags in
+ * fl_pangolin_damage.cc).
+ */
+void fl_pangolin_damage_set(GdkWindow* window, cairo_region_t* region);
+
+G_END_DECLS
+
+#endif  // FLUTTER_SHELL_PLATFORM_LINUX_FL_PANGOLIN_DAMAGE_H_
