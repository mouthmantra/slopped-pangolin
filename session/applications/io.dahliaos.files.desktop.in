[Desktop Entry]
Type=Application
Name=Files
Comment=Browse and organize your files
Exec=@BINDIR@/dahlia_apps files %F
Icon=io.dahliaos.files
Categories=System;FileTools;FileManager;
Keywords=folder;manager;explore;disk;filesystem;
StartupWMClass=io.dahliaos.files
StartupNotify=false
Terminal=false
MimeType=inode/directory;
