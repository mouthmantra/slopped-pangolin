<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Copyright 2026 The dahliaOS Authors
     SPDX-License-Identifier: Apache-2.0

     The Logs app reads the system journal and kernel messages through
     pangolin-read-logs (fixed read-only commands), asking once for a few
     minutes rather than on every refresh. -->
<policyconfig>
  <vendor>dahliaOS</vendor>
  <vendor_url>https://dahliaos.io</vendor_url>
  <action id="io.dahliaos.logs.read">
    <description>Read system logs</description>
    <message>Authentication is required to read system and kernel logs</message>
    <icon_name>io.dahliaos.logs</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@PREFIX@/libexec/pangolin/pangolin-read-logs</annotate>
  </action>
</policyconfig>
